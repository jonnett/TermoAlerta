<?xml version="1.0" encoding="utf-8"?>
<!-- Seguridad: no se respaldan ni se transfieren las lecturas ni los ajustes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
